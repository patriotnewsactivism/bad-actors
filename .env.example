# Bad Actors production environment
# Canonical hosting target: Vercel
# Configure server-side secrets in Vercel Project Settings -> Environment Variables.

# Transactional email (required for free-album delivery)
RESEND_API_KEY=re_xxxxxxxxx

# Subscriber storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional fallback only when intentionally configured with appropriate RLS
SUPABASE_ANON_KEY=your-anon-key

# Optional lead forwarding to BuildMyBot
PORTFOLIO_INTAKE_SECRET=your-shared-intake-secret
BUILDMYBOT_INTAKE_URL=https://www.buildmybot.app/api/leads/capture

# Legacy browser-side EmailJS fallback. The free-album flow should use Resend through /api/subscribe.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
